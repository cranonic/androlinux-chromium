<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlpineChrome" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorError">@color/md_error</item>
        <item name="android:colorBackground">@color/md_bg</item>
        <item name="android:statusBarColor">@color/md_bg</item>
        <item name="android:navigationBarColor">@color/md_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/md_bg</item>
    </style>

    <!-- Cold start: solid dark + transparent icon so our in-app loader owns the logo -->
    <style name="Theme.AlpineChrome.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.AlpineChrome</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
