<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_bg">

    <!-- Chromium preview surface: WebView hosts noVNC / remote display -->
    <WebView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:overScrollMode="never" />

    <!-- Startup / session loading overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_chromium_logo"
            app:layout_constraintBottom_toTopOf="@id/loading_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:text="@string/browser_loading"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/md_on_surface_variant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            app:indicatorColor="@color/md_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loading_text"
            app:trackColor="@color/progress_track" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Error banner (only on real errors) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/md_surface"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/md_error"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/error_banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/md_error"
            android:textIsSelectable="true" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Logs FAB — visibility controlled from Settings -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_logs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/logs_title"
        app:srcCompat="@android:drawable/ic_menu_info_details"
        app:tint="@color/md_on_primary"
        app:backgroundTint="@color/md_primary" />
</FrameLayout>
